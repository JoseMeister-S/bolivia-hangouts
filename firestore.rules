rules_version = '2';

// Security model (see README):
// - Friends sign in anonymously and register the invite code once in
//   members/{uid}. Every read checks that the registered code still equals
//   settings/main.invite_code, so rotating the code locks out old links.
// - Pending proposals live in `proposals`, which friends can create but never
//   read.
// - Privacy: a confirmed hangout is private unless the admin marks it open.
//   Friends can read only hangouts with open == true (and their participants).
//   For everything else they see `blocked_slots`, a public projection that
//   says "this slot is taken" and carries a label only when the admin opened
//   it. The real labels live in `reservations`, which is admin-only. A
//   hangout's note to the host lives in `hangout_private`, also admin-only,
//   because a friend who may read a hangout reads all of its fields.
// - A plan can have a limit (`capacity`, the whole gathering, host included).
//   Joining bumps `going` in the same batch as the participant and a
//   `joined/{uid}` document for the joining device. A full plan is readable
//   only by the devices that joined it; everyone else sees "Ocupado".
// - Where a plan happens (`hangout_places`) is readable only by the admin and
//   the devices that joined it.
// - `receipts/{proposalId}` tells a proposer what happened to their own
//   proposal (and its date, slot and title, which the admin may have edited).
//   It can be fetched only by id, and only the proposer's device knows that
//   id: an approved hangout gets a new id, so the ids friends see on open
//   hangouts never open a receipt.
// - Admin = signed-in user with a document in `admins`. That collection cannot
//   be written by any client; add the document in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function settings() {
      return get(/databases/$(database)/documents/settings/main).data;
    }

    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.code
           == settings().invite_code;
    }

    // Trimmed string with a length between min and max.
    function text(s, min, max) {
      return s is string && s.size() >= min && s.size() <= max && s == s.trim();
    }

    function hangoutPath(id) {
      return /databases/$(database)/documents/hangouts/$(id);
    }

    function joinedPath(id, uid) {
      return /databases/$(database)/documents/hangouts/$(id)/joined/$(uid);
    }

    // This device joined the hangout.
    function hasJoined(id) {
      return request.auth != null && exists(joinedPath(id, request.auth.uid));
    }

    // A friend sees an open hangout while it has room, or once they are in it.
    function canSee(id, hangout) {
      return isMember() && hangout.open == true && (hangout.full == false || hasJoined(id));
    }

    // The same batch adds exactly one person to the hangout.
    function goingBumped(id) {
      return getAfter(hangoutPath(id)).data.going == get(hangoutPath(id)).data.going + 1;
    }

    // The same batch takes exactly one person off the hangout.
    function goingDropped(id) {
      return getAfter(hangoutPath(id)).data.going == get(hangoutPath(id)).data.going - 1;
    }

    // The new count and the `full` that follows from it (the host counts too).
    function countFits(hangout, going) {
      return request.resource.data.going == going
        && request.resource.data.full == (hangout.capacity != null && going + 1 >= hangout.capacity);
    }

    // Optional proposal fields: a limit, and a place (a web link and a pin).
    function validExtras(data) {
      return (!('capacity' in data) || data.capacity == null
               || (data.capacity is int && data.capacity >= 2 && data.capacity <= 50))
        && (!('uid' in data) || data.uid == request.auth.uid)
        && (!('map_url' in data) || (data.map_url is string && data.map_url.size() <= 500
               && (data.map_url == '' || data.map_url.matches('https?://[^ ]+'))))
        && (!('lat' in data) || data.lat == null || (data.lat is number && data.lat >= -90 && data.lat <= 90))
        && (!('lng' in data) || data.lng == null || (data.lng is number && data.lng >= -180 && data.lng <= 180));
    }

    function counterPath() {
      return /databases/$(database)/documents/counters/proposals;
    }

    // True only if this same batch also bumped the rate-limit counter for
    // exactly this proposal id (so one bump cannot cover many proposals).
    function counterBumpedFor(id) {
      let before = get(counterPath()).data;
      let after = getAfter(counterPath()).data;
      return after.last_id == id
        && (after.count == before.count + 1
            || (after.count == 1 && after.window_start == request.time));
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      // No client writes at all.
    }

    match /settings/main {
      allow get: if isMember() || isAdmin();
      allow list, write: if isAdmin();
    }

    match /members/{uid} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code is string
        && request.resource.data.code == settings().invite_code;
      allow read, delete: if isAdmin();
    }

    match /blocked_slots/{id} {
      allow read: if isMember() || isAdmin();
      // A private item carries no label and the neutral kind 'busy', so a
      // friend cannot tell a private plan from the host's private time. An
      // open plan is { label: '', kind: 'open' }.
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['date', 'slot', 'label', 'kind'])
        && (request.resource.data.label != '' || request.resource.data.kind in ['busy', 'open']);
      allow delete: if isAdmin();
    }

    match /reservations/{id} {
      allow read, write: if isAdmin();
    }

    match /receipts/{id} {
      allow get: if isMember();
      allow list, write: if isAdmin();
    }

    match /hangouts/{id} {
      // A friend's query must itself ask for open == true and full == false,
      // or it is refused. A full plan is fetched by id by those in it.
      allow read: if isAdmin() || canSee(id, resource.data);
      // The note stays out: it goes to hangout_private.
      allow create, update: if isAdmin() && !request.resource.data.keys().hasAny(['note']);
      allow delete: if isAdmin();
      // Joining: one more person, never past the limit, and `full` follows
      // from the new count (going + the host). Only together with this
      // device's new joined document.
      allow update: if isMember()
        && resource.data.open == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['going', 'full'])
        && countFits(resource.data, resource.data.going + 1)
        && (resource.data.capacity == null || request.resource.data.going + 1 <= resource.data.capacity)
        && !exists(joinedPath(id, request.auth.uid))
        && existsAfter(joinedPath(id, request.auth.uid));
      // Leaving: one less, together with removing this device's joined
      // document (and its participant).
      allow update: if isMember()
        && resource.data.open == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['going', 'full'])
        && countFits(resource.data, resource.data.going - 1)
        && exists(joinedPath(id, request.auth.uid))
        && !existsAfter(joinedPath(id, request.auth.uid));

      match /participants/{pid} {
        // The document id is the lower-cased name, which makes names unique
        // per hangout (a second join with the same name is an update: denied).
        allow read: if canSee(id, get(hangoutPath(id)).data);
        allow create: if isMember()
          && get(hangoutPath(id)).data.open == true
          && request.resource.data.keys().hasOnly(['name', 'created_at'])
          && request.resource.data.keys().hasAll(['name', 'created_at'])
          && request.resource.data.created_at == request.time
          && text(request.resource.data.name, 1, 40)
          && pid == request.resource.data.name.lower()
          && getAfter(joinedPath(id, request.auth.uid)).data.key == pid
          && goingBumped(id);
        // A friend takes back only their own name, as their device joined it.
        allow delete: if isMember()
          && get(joinedPath(id, request.auth.uid)).data.key == pid
          && !existsAfter(joinedPath(id, request.auth.uid))
          && goingDropped(id);
        allow read, write: if isAdmin();
      }

      // Which devices joined (their anonymous uid) and as which participant.
      match /joined/{uid} {
        allow create: if isMember()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'key'])
          && request.resource.data.keys().hasAll(['uid', 'key'])
          && request.resource.data.uid == uid
          && request.resource.data.key is string
          && !exists(/databases/$(database)/documents/hangouts/$(id)/participants/$(request.resource.data.key))
          && existsAfter(/databases/$(database)/documents/hangouts/$(id)/participants/$(request.resource.data.key))
          && goingBumped(id);
        allow delete: if isMember()
          && uid == request.auth.uid
          && !existsAfter(/databases/$(database)/documents/hangouts/$(id)/participants/$(resource.data.key))
          && goingDropped(id);
        allow read, write: if isAdmin();
      }
    }

    // A device finds the plans it joined: a collection-group query that must
    // ask for its own uid.
    match /{path=**}/joined/{uid} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // Where a plan happens: { map_url, lat, lng }. Only the admin and the
    // devices that joined the plan may read it.
    match /hangout_places/{id} {
      allow get: if isMember() && hasJoined(id);
      allow read, write: if isAdmin();
    }

    // The admin-only side of a hangout: { note, receipt (the proposal id) }.
    match /hangout_private/{id} {
      allow read, write: if isAdmin();
    }

    // Collection-group read for the admin page (all names in one query).
    match /{path=**}/participants/{pid} {
      allow read: if isAdmin();
    }

    match /proposals/{id} {
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(
             ['date', 'slot', 'title', 'place', 'proposer_name', 'note', 'status', 'created_at',
              'capacity', 'uid', 'map_url', 'lat', 'lng'])
        && request.resource.data.keys().hasAll(
             ['date', 'slot', 'title', 'place', 'proposer_name', 'note', 'status', 'created_at'])
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at == request.time
        && request.resource.data.slot in ['manana', 'almuerzo', 'tarde', 'noche']
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.date >= settings().trip_start
        && request.resource.data.date <= settings().trip_end
        && text(request.resource.data.title, 1, 80)
        && text(request.resource.data.place, 0, 80)
        && text(request.resource.data.proposer_name, 1, 40)
        && text(request.resource.data.note, 0, 280)
        && validExtras(request.resource.data)
        // A taken slot refuses proposals, unless what takes it is an open plan.
        && (!exists(/databases/$(database)/documents/blocked_slots/$(request.resource.data.date + '_' + request.resource.data.slot))
            || get(/databases/$(database)/documents/blocked_slots/$(request.resource.data.date + '_' + request.resource.data.slot)).data.kind == 'open')
        && counterBumpedFor(id);
      // The device that sent a proposal may take it back while it waits.
      allow delete: if isMember()
        && resource.data.status == 'pending'
        && resource.data.get('uid', null) == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // Rate limit: at most 20 proposals per 24 h window, all friends together.
    // The window starts with the first proposal after the previous one ended.
    // A proposal must bump this counter in the same batch.
    match /counters/proposals {
      allow update: if isMember()
        && request.resource.data.keys().hasOnly(['count', 'window_start', 'last_id'])
        && request.resource.data.keys().hasAll(['count', 'window_start', 'last_id'])
        && request.resource.data.last_id is string
        && (
          (request.time < resource.data.window_start + duration.value(24, 'h')
            && request.resource.data.window_start == resource.data.window_start
            && request.resource.data.count == resource.data.count + 1
            && request.resource.data.count <= 20)
          ||
          (request.time >= resource.data.window_start + duration.value(24, 'h')
            && request.resource.data.window_start == request.time
            && request.resource.data.count == 1)
        );
      allow read, write: if isAdmin();
    }
  }
}
