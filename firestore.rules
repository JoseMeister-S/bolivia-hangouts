rules_version = '2';

// Security model (see README):
// - Friends sign in anonymously and register the invite code once in
//   members/{uid}. Every read checks that the registered code still equals
//   settings/main.invite_code, so rotating the code locks out old links.
// - Pending proposals live in `proposals`, which friends can create but never
//   read.
// - Privacy: a confirmed hangout is private unless the admin marks it open.
//   Friends can read only hangouts with open == true (and their participants).
//   For everything else they see `blocked_slots`, a public projection that
//   says "this slot is taken" and carries a label only when the admin opened
//   it. The real labels live in `reservations`, which is admin-only.
// - `receipts/{proposalId}` tells a proposer whether their own proposal was
//   confirmed. It can be fetched only by id, and only the proposer's device
//   knows that id.
// - Admin = signed-in user with a document in `admins`. That collection cannot
//   be written by any client; add the document in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function settings() {
      return get(/databases/$(database)/documents/settings/main).data;
    }

    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.code
           == settings().invite_code;
    }

    // Trimmed string with a length between min and max.
    function text(s, min, max) {
      return s is string && s.size() >= min && s.size() <= max && s == s.trim();
    }

    function counterPath() {
      return /databases/$(database)/documents/counters/proposals;
    }

    // True only if this same batch also bumped the rate-limit counter for
    // exactly this proposal id (so one bump cannot cover many proposals).
    function counterBumpedFor(id) {
      let before = get(counterPath()).data;
      let after = getAfter(counterPath()).data;
      return after.last_id == id
        && (after.count == before.count + 1
            || (after.count == 1 && after.window_start == request.time));
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      // No client writes at all.
    }

    match /settings/main {
      allow get: if isMember() || isAdmin();
      allow list, write: if isAdmin();
    }

    match /members/{uid} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code is string
        && request.resource.data.code == settings().invite_code;
      allow read, delete: if isAdmin();
    }

    match /blocked_slots/{id} {
      allow read: if isMember() || isAdmin();
      allow write: if isAdmin();
    }

    match /reservations/{id} {
      allow read, write: if isAdmin();
    }

    match /receipts/{id} {
      allow get: if isMember();
      allow list, write: if isAdmin();
    }

    match /hangouts/{id} {
      // A friend's query must itself ask for open == true, or it is refused.
      allow read: if isAdmin() || (isMember() && resource.data.open == true);
      allow write: if isAdmin();

      match /participants/{pid} {
        // The document id is the lower-cased name, which makes names unique
        // per hangout (a second join with the same name is an update: denied).
        allow read: if isMember()
          && get(/databases/$(database)/documents/hangouts/$(id)).data.open == true;
        allow create: if isMember()
          && get(/databases/$(database)/documents/hangouts/$(id)).data.open == true
          && request.resource.data.keys().hasOnly(['name', 'created_at'])
          && request.resource.data.keys().hasAll(['name', 'created_at'])
          && request.resource.data.created_at == request.time
          && text(request.resource.data.name, 1, 40)
          && pid == request.resource.data.name.lower();
        allow read, write: if isAdmin();
      }
    }

    // Collection-group read for the admin page (all names in one query).
    match /{path=**}/participants/{pid} {
      allow read: if isAdmin();
    }

    match /proposals/{id} {
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(
             ['date', 'slot', 'title', 'place', 'proposer_name', 'note', 'status', 'created_at'])
        && request.resource.data.keys().hasAll(
             ['date', 'slot', 'title', 'place', 'proposer_name', 'note', 'status', 'created_at'])
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at == request.time
        && request.resource.data.slot in ['manana', 'almuerzo', 'tarde', 'noche']
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.date >= settings().trip_start
        && request.resource.data.date <= settings().trip_end
        && text(request.resource.data.title, 1, 80)
        && text(request.resource.data.place, 0, 80)
        && text(request.resource.data.proposer_name, 1, 40)
        && text(request.resource.data.note, 0, 280)
        && !exists(/databases/$(database)/documents/blocked_slots/$(request.resource.data.date + '_' + request.resource.data.slot))
        && counterBumpedFor(id);
      allow read, update, delete: if isAdmin();
    }

    // Rate limit: at most 20 proposals per rolling 24 h window, all friends
    // together. A proposal must bump this counter in the same batch.
    match /counters/proposals {
      allow update: if isMember()
        && request.resource.data.keys().hasOnly(['count', 'window_start', 'last_id'])
        && request.resource.data.keys().hasAll(['count', 'window_start', 'last_id'])
        && request.resource.data.last_id is string
        && (
          (request.time < resource.data.window_start + duration.value(24, 'h')
            && request.resource.data.window_start == resource.data.window_start
            && request.resource.data.count == resource.data.count + 1
            && request.resource.data.count <= 20)
          ||
          (request.time >= resource.data.window_start + duration.value(24, 'h')
            && request.resource.data.window_start == request.time
            && request.resource.data.count == 1)
        );
      allow read, write: if isAdmin();
    }
  }
}
